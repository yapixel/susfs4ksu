 security/selinux/avc.c |   22 ++++
 19 files changed, 991 insertions(+), 17 deletions(-)

diff --git a/fs/Makefile b/fs/Makefile
index da2f2c9..08f5128 100644
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -20,6 +20,7 @@ obj-y +=	no-block.o
 endif
 
 obj-$(CONFIG_PROC_FS) += proc_namespace.o
+obj-$(CONFIG_KSU_SUSFS) += susfs.o
 
 obj-$(CONFIG_BLK_DEV_INTEGRITY) += bio-integrity.o
 obj-y				+= notify/
diff --git a/fs/ioprio.c b/fs/ioprio.c
index 5634356..cde3b3a 100644
--- a/fs/ioprio.c
+++ b/fs/ioprio.c
@@ -29,6 +29,10 @@
 #include <linux/security.h>
 #include <linux/pid_namespace.h>
 
+#ifdef CONFIG_KSU_SUSFS
+extern bool susfs_is_priority_uid_filtered(uid_t uid);
+#endif // #ifdef CONFIG_KSU_SUSFS
+
 int set_task_ioprio(struct task_struct *task, int ioprio)
 {
 	int err;
@@ -114,6 +118,10 @@ SYSCALL_DEFINE3(ioprio_set, int, which, int, who, int, ioprio)
 			uid = make_kuid(current_user_ns(), who);
 			if (!uid_valid(uid))
